modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
NEXT_PUBLIC_SUPABASE_URL = "https://vmgfoevjlligsgmqascg.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY = "sb_publishable_ikeRxy6AzoNQuIeoeF9aww_4FideNeP"
VITE_SUPABASE_URL = "https://vwgfoevjiliggsgmqacg.supabase.co"
VITE_SUPABASE_ANON_KEY = "sb_publishable_ikeRxy6AzoNQuIeoeF9aww_4FideNeP"

[nix]
channel = "stable-25_05"
packages = ["glib", "nspr", "nss", "atk", "at-spi2-atk", "at-spi2-core", "cairo", "cups", "dbus", "expat", "fontconfig", "freetype", "libdrm", "libxkbcommon", "pango", "gtk3", "mesa", "alsa-lib", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXi", "xorg.libXrandr", "xorg.libxcb", "xorg.libxshmfence", "libgbm"]

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 22294
externalPort = 80
